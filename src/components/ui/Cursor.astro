<div id="trailer"></div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const trailer = document.getElementById("trailer");

    if (!trailer) {
      console.error("Cursor trailer element not found");
      return;
    }

    // Make cursor visible immediately
    trailer.style.opacity = "1";

    const animateTrailer = (e: MouseEvent) => {
      const x = e.clientX - trailer.offsetWidth / 2;
      const y = e.clientY - trailer.offsetHeight / 2;

      const keyframes = {
        transform: `translate(${x}px, ${y}px) scale(1)`,
      };

      trailer.animate(keyframes, {
        duration: 1800,
        fill: "forwards",
      });
    };

    window.addEventListener("mousemove", animateTrailer);
  });
</script>
<style>
  #trailer {
    position: fixed;
    top: calc(-30 * var(--unit-fx));
    left: calc(30 * var(--unit-fx));
    transform: translate(-100px, -100px);
    opacity: 0;
    z-index: 1000;
    mix-blend-mode: difference;
    transition: all 500ms cubic-bezier(0.645, 0.045, 0.355, 1);
    will-change: transform;
    border-radius: calc(3 * var(--unit-fx));
    background-color: var(--color-text-secondary);
    width: calc(12 * var(--unit-fx));
    height: calc(13 * var(--unit-fx));
    pointer-events: none;
  }

  @media (pointer: coarse) {
    #trailer {
      display: none;
    }
  }
</style>
