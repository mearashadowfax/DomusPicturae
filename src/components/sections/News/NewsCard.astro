---
/** Summary card for a news post. */
import { useUI, type Locale } from "@/i18n";
import type { NewsPresentation } from "@utils/programme";

interface Props {
  post: NewsPresentation;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useUI(locale);
const { title } = post;
---

<li class="news-card">
  <div class="news-card-header">
    <span class="news-card-date">[{post.dateLabel}]</span>
    <h3 class="news-card-title">{title}</h3>
  </div>
  <p class="news-card-summary">{post.description}</p>
  <a class="news-card-link link-underline" href={post.href}>
    {t.news.readMore}
    <span class="visually-hidden">: {title}</span>
  </a>
</li>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .news-card-header {
    display: grid;
    grid-template-columns: calc(60 * var(--unit-fx)) 1fr;
    align-items: baseline;
    gap: calc(15 * var(--unit-fx));
  }

  .news-card-date {
    font-size: calc(13 * var(--unit-type));
  }

  .news-card-title {
    font-size: calc(18 * var(--unit-type));
    font-family: var(--font-baskervville);
  }

  .news-card-summary {
    display: -webkit-box;
    margin-block: calc(12 * var(--unit-fx));
    font-size: calc(18 * var(--unit-type));
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .news-card-link {
    display: inline-block;
    align-self: flex-start;
    font-size: calc(13 * var(--unit-type));
  }

  @media screen and (max-width: 1024px) {
    .news-card-link {
      font-size: calc(14 * var(--unit-type));
    }
  }

  @media screen and (max-width: 600px) {
    .news-card-header {
      grid-template-columns: calc(45 * var(--unit-fx)) 1fr;
    }

    .news-card-date {
      font-size: calc(12 * var(--unit-type));
    }
  }
</style>
