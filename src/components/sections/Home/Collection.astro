---
/** Featured artworks chosen in the `homepage` singleton, revealed as the page scrolls. */
import { Image } from "astro:assets";
import type { Homepage } from "@utils/homepage";

interface Props {
  featured: Homepage["featured"];
}

const { featured } = Astro.props;
---

<section class="collection">
  {featured.map(({ presentation, image, caption }) => (
    <div class="collection-item">
      <a href={presentation.href}>
        <div class="collection-image">
          <Image
            src={image.src}
            alt={image.alt}
            format="webp"
            width={900}
            loading="lazy"
          />
        </div>
        <p class="collection-caption">
          {presentation.artist.name}
          <br />
          <em>{caption}</em>
        </p>
      </a>
    </div>
  ))}
</section>

<style>
  .collection {
    width: 100%;
  }

  .collection-item {
    position: relative;
    margin-bottom: calc(100 * var(--unit-fx));
    width: 40%;
  }

  .collection-item:nth-child(4n + 1) {
    left: 5%;
  }
  .collection-item:nth-child(4n + 2) {
    left: 50%;
  }
  .collection-item:nth-child(4n + 3) {
    left: 20%;
  }
  .collection-item:nth-child(4n + 4) {
    left: 50%;
  }

  .collection-image {
    position: relative;
    visibility: hidden;
    margin-inline: auto;
    border-radius: var(--radius);
    width: calc(390 * var(--unit-fx));
    max-width: calc(400 * var(--unit-fx));
    height: calc(540 * var(--unit-fx));
    overflow: hidden;
  }

  .collection-image img {
    transform-origin: left;
    will-change: transform;
    border-radius: var(--radius);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-caption {
    margin-inline: auto;
    margin-top: calc(8 * var(--unit-fx));
    width: calc(390 * var(--unit-fx));
    max-width: calc(400 * var(--unit-fx));
    color: var(--color-text-primary);
  }

  /*
   * Tablets: the image fills its column instead of a fixed 390 units,
   * which is wider than the 40% column below ~1000px.
   */
  @media screen and (max-width: 1024px) {
    .collection-image {
      aspect-ratio: 390 / 540;
      width: 100%;
      height: auto;
    }

    .collection-caption {
      width: 100%;
    }
  }

  @media screen and (max-width: 600px) {
    .collection {
      padding: 0 var(--gutter);
    }

    .collection-item,
    .collection-item:nth-child(n) {
      left: 0;
      margin-bottom: 4em;
      width: 100%;
    }

    .collection-image {
      width: calc(250 * var(--unit-fx));
      height: calc(350 * var(--unit-fx));
    }

    .collection-caption {
      width: 75%;
      font-size: calc(16 * var(--unit-type));
    }
  }
</style>
