---
/** Full-bleed teaser for the About page with a mouse-parallax image field. */
import { Image } from "astro:assets";
import { type Locale } from "@/i18n";
import { text } from "@/i18n/localized";
import { getHomepage } from "@utils/content";
import { pictures } from "@utils/images";
import { routes } from "@/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { about } = (await getHomepage()).data;

const items = pictures(about.galleryItems, locale);
---

<section class="about">
  <div class="about-title">
    <h2>{text(about.content, locale)}</h2>
    <a href={routes.about(locale)} class="link-underline"
      >{text(about.buttonText, locale)}</a
    >
  </div>
  <div class="about-gallery">
    {
      items.map((item) => (
        <div
          class="about-item"
          style={`top: ${item.source.top}%; left: ${item.source.left}%;`}
          data-parallax-speed={item.source.parallaxSpeed}
        >
          <Image
            src={item.src}
            alt={item.alt}
            format="webp"
            width={500}
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  .about {
    position: relative;
    margin: auto;
    border-radius: var(--radius);
    background: var(--color-bg-secondary);
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  .about-title {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .about-title h2 {
    margin-bottom: calc(30 * var(--unit-fx));
    color: var(--color-text-secondary);
    font-weight: 300;
    font-size: calc(50 * var(--unit-fx));
    line-height: 1.3;
    font-family: var(--font-baskervville);
    text-align: center;
  }

  .about-title a {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-on-dark-muted);
    font-size: calc(25 * var(--unit-fx));
  }

  .about-gallery {
    width: 100%;
    height: 100%;
  }

  .about-item {
    position: absolute;
    width: 200px;
    height: 275px;
  }

  .about-item img {
    opacity: 0.5;
    border-radius: var(--radius);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 600px) {
    .about-title {
      top: 50%;
      width: 75%;
    }

    .about-title h2 {
      font-size: calc(25 * var(--unit-fx));
    }

    .about-title a {
      width: 100%;
      font-size: calc(20 * var(--unit-fx));
      text-align: center;
    }

    .about-item:nth-child(2),
    .about-item:nth-child(3),
    .about-item:nth-child(4),
    .about-item:nth-child(7),
    .about-item:nth-child(8) {
      display: none;
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from "@scripts/motion";

  const gallery = document.querySelector<HTMLElement>(".about-gallery");
  if (gallery && !reducedMotion) {
    const items = gallery.querySelectorAll<HTMLElement>(".about-item");

    const onMouseMove = (event: MouseEvent) => {
      items.forEach((item) => {
        const speed = parseFloat(item.dataset.parallaxSpeed || "0.05");
        gsap.to(item, {
          x: (event.clientX - window.innerWidth / 2) * speed,
          y: (event.clientY - window.innerHeight / 2) * speed,
          duration: 0.75,
        });
      });
    };

    new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) =>
          entry.isIntersecting
            ? document.addEventListener("mousemove", onMouseMove)
            : document.removeEventListener("mousemove", onMouseMove),
        ),
      { threshold: 0.1 },
    ).observe(gallery);

    // Starts fully transparent: the section is still below the viewport at
    // that point, and a faint-but-visible title fails the contrast audit.
    gsap.set(".about-title", { opacity: 0 });
    gsap.set(".about-title, .about-item img", { scale: 0.3 });
    gsap.set(".about", { width: "30%" });

    const reveal = gsap.timeline({
      scrollTrigger: {
        trigger: ".about",
        start: "top bottom",
        end: "40% center",
        scrub: true,
      },
    });
    reveal.to(".about", { width: "100%" }, 0);
    reveal.to(".about-title", { scale: 1, opacity: 1 }, 0);
    reveal.to(".about-item img", { scale: 1 }, 0);
  }
</script>
