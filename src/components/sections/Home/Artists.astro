---
/** Alphabetical list of artists; hovering a name shows their portrait and short bio. */
import { Image } from "astro:assets";
import { useUI, type Locale } from "@/i18n";
import { text } from "@/i18n/localized";
import { getArtistsSorted } from "@utils/content";
import { picture } from "@utils/images";
import { routes } from "@/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const artists = await getArtistsSorted();
---

<section class="artists">
  <h2 class="artists-title">{t.home.artists}</h2>
  <hr class="artists-rule" />
  <ul class="artists-list">
    {
      artists.map((artist) => {
        const portrait = picture(artist.data, locale, artist.data.name);
        return (
          <li class="artist-item">
            <a class="artist-link" href={routes.artist(locale, artist)}>
              {artist.data.name}
            </a>
            <div class="artist-preview">
              <div class="artist-preview-inner">
                {portrait && (
                  <Image
                    src={portrait.src}
                    alt={portrait.alt}
                    format="webp"
                    width={600}
                    class="artist-portrait"
                  />
                )}
                <p class="artist-bio">{text(artist.data.shortBio, locale)}</p>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .artists {
    margin-inline: auto;
    margin-block: calc(250 * var(--unit-fx));
    padding-inline: calc(40 * var(--unit-fx));
    width: 100%;
    line-height: 1.4;
  }

  .artists-title {
    opacity: 0;
    will-change: transform;
    font-weight: 300;
    font-size: calc(25 * var(--unit-fx));
    line-height: 1.2;
  }

  .artists-rule {
    transform: scaleX(0);
    transform-origin: left;
    margin-top: calc(10 * var(--unit-fx));
    border: none;
    background-color: var(--color-divider);
    height: calc(0.5 * var(--unit-fx));
  }

  .artists-list {
    position: relative;
    margin-block: calc(50 * var(--unit-fx));
    list-style: none;
  }

  .artist-link {
    display: inline-block;
    position: relative;
    /* 0.7 keeps the primary text at >= 4.5:1 on white; 0.5 fell to 2.8:1. */
    opacity: 0.7;
    transition: opacity var(--transition-base);
    font-size: calc(45 * var(--unit-fx));
    line-height: 1.2;
    font-family: var(--font-baskervville);
  }

  .artist-link:hover {
    opacity: 1;
  }

  .artist-preview {
    position: absolute;
    top: 0;
    right: 0;
    opacity: 0;
    transition: opacity var(--transition-fast);
    width: calc(230 * var(--unit-fx));
    height: 100vh;
    pointer-events: none;
  }

  .artist-link:hover ~ .artist-preview {
    opacity: 1;
  }

  .artist-preview-inner {
    position: sticky;
    top: calc(30 * var(--unit-fx));
  }

  .artist-portrait {
    border-radius: var(--radius);
    width: calc(230 * var(--unit-fx));
    height: 20vw;
    object-fit: cover;
  }

  .artist-bio {
    padding-top: calc(10 * var(--unit-fx));
    font-size: calc(14 * var(--unit-fx));
  }

  @media screen and (max-width: 600px) {
    .artists {
      padding-inline: 0;
    }

    .artists-rule {
      transform: scaleX(1);
    }

    .artist-link {
      font-size: calc(25 * var(--unit-fx));
    }

    .artist-item + .artist-item {
      margin-top: calc(10 * var(--unit-fx));
    }

    .artist-preview {
      display: none;
    }
  }
</style>
