---
/** 404 page: a horizontal scroll of artworks drifting past a giant title. */
import { Image } from "astro:assets";
import MainLayout from "@layouts/MainLayout.astro";
import { useUI, type Locale } from "@/i18n";
import image1 from "@images/not-found/1.jpg";
import image2 from "@images/not-found/2.jpg";
import image3 from "@images/not-found/3.jpg";
import image4 from "@images/not-found/4.jpg";
import { routes } from "@/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useUI(locale);
const images = [image1, image2, image3, image4];
---

<MainLayout locale={locale} title={t.notFound.title} theme="dark" scroll="slow">
  <section class="not-found">
    <h1>{t.notFound.title}</h1>
    {
      images.map((image, index) => (
        <div class="not-found-card" id={`not-found-card-${index + 1}`}>
          <Image
            src={image}
            alt=""
            format="webp"
            width={700}
            loading={index < 2 ? "eager" : "lazy"}
          />
        </div>
      ))
    }
  </section>
  <section class="not-found-outro">
    <div>
      <p>
        {t.notFound.firstLine}
        <br />
        {t.notFound.secondLine}
      </p>
      <a href={routes.home(locale)} class="link-underline" data-go-back
        >{t.notFound.goBack}</a
      >
    </div>
  </section>
</MainLayout>

<style is:global>
  html,
  body {
    background-color: var(--color-bg-secondary);
    width: 100%;
    height: 100%;
    font-weight: 300;
    font-family: var(--font-baskervville);
  }
</style>

<style>
  .not-found {
    position: absolute;
    top: 0;
    will-change: transform;
    width: 400vw;
    height: 100vh;
  }

  .not-found h1 {
    margin-left: calc(-150 * var(--unit-fx));
    width: 100%;
    color: white;
    font-size: 48vw;
    line-height: 1;
    text-align: center;
  }

  .not-found-card {
    position: absolute;
    border-radius: var(--radius);
    width: calc(300 * var(--unit-fx));
    height: calc(300 * var(--unit-fx));
    overflow: hidden;
  }

  .not-found-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #not-found-card-1 {
    top: 50%;
    left: 20%;
  }
  #not-found-card-2 {
    top: 25%;
    left: 40%;
    z-index: -1;
  }
  #not-found-card-3 {
    top: 45%;
    left: 60%;
  }
  #not-found-card-4 {
    top: 15%;
    left: 80%;
    z-index: -1;
  }

  .not-found-outro {
    position: absolute;
    top: 150vh;
    width: 100%;
    height: 100vh;
  }

  .not-found-outro div {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    color: var(--color-text-on-dark-muted);
    font-size: calc(25 * var(--unit-fx));
    text-align: center;
  }

  .not-found-outro a {
    display: inline-block;
    margin-top: calc(24 * var(--unit-fx));
    font-size: calc(16 * var(--unit-fx));
  }

  @media (max-width: 900px) {
    .not-found {
      padding-top: 20em;
    }
  }

  /* Phones: a static page — the title, two of the artworks and the way back. */
  @media screen and (max-width: 600px) {
    .not-found {
      display: flex;
      position: static;
      flex-wrap: wrap;
      gap: calc(15 * var(--unit-fx));
      padding: calc(140 * var(--unit-fx)) var(--gutter) 0;
      width: 100%;
      height: auto;
    }

    .not-found h1 {
      margin-bottom: calc(30 * var(--unit-fx));
      margin-left: 0;
      font-size: 22vw;
      letter-spacing: calc(-2 * var(--unit-fx));
      text-align: left;
    }

    #not-found-card-1,
    #not-found-card-2 {
      position: static;
      z-index: auto;
      width: calc(50% - calc(8 * var(--unit-fx)));
      height: 45vw;
    }

    #not-found-card-3,
    #not-found-card-4 {
      display: none;
    }

    .not-found-outro {
      position: static;
      padding: calc(60 * var(--unit-fx)) var(--gutter)
        calc(120 * var(--unit-fx));
      width: 100%;
      height: auto;
    }

    .not-found-outro div {
      position: static;
      transform: none;
      width: 100%;
      font-size: calc(20 * var(--unit-fx));
      text-align: left;
    }
  }
</style>

<script>
  import { gsap, onDesktop, ScrollTrigger } from "@scripts/motion";

  const cards = [
    { id: "#not-found-card-1", x: -2000, rotate: 45 },
    { id: "#not-found-card-2", x: -1000, rotate: -30 },
    { id: "#not-found-card-3", x: -2000, rotate: 45 },
    { id: "#not-found-card-4", x: -1500, rotate: -30 },
  ];

  /*
   * One trigger drives the title and the cards. Separate card triggers on
   * ".not-found" would not work: ScrollTrigger pushes any trigger that
   * targets a pinned element to start after that pin ends. "max" spans the
   * page's whole scroll range, so the title finishes its travel just as the
   * outro (at 150vh) arrives. Relative ends only understand px and "%", not
   * "vh".
   *
   * Phones get a static page instead (see the stylesheet), so the scene is
   * only built on desktop and torn down if the viewport crosses over.
   */
  onDesktop(() => {
    const trigger = ScrollTrigger.create({
      trigger: ".not-found",
      start: "top top",
      end: "max",
      scrub: 1,
      pin: true,
      pinSpacing: false,
      onUpdate: ({ progress }) => {
        gsap.to(".not-found", {
          x: `${-350 * progress}vw`,
          duration: 0.5,
          ease: "power3.out",
        });
        // The artworks drift more slowly than the title they float over.
        const drift = progress * 0.75;
        cards.forEach((card) =>
          gsap.to(card.id, {
            x: card.x * drift,
            rotate: card.rotate * drift * 2,
            duration: 0.5,
            ease: "power3.out",
          }),
        );
      },
    });
    return () => {
      trigger.kill();
      gsap.set([".not-found", ...cards.map((card) => card.id)], {
        clearProps: "transform",
      });
    };
  });

  document
    .querySelector<HTMLAnchorElement>("[data-go-back]")
    ?.addEventListener("click", (event) => {
      if (window.history.length > 1) {
        event.preventDefault();
        history.back();
      }
    });
</script>
