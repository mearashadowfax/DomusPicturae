---
/**
 * Artwork detail. Serves both `/artworks/[id]` and `/private-collection/[id]`:
 * a work that is not for sale renders on the dark theme, without the enquiry
 * button.
 */
import { Image, getImage } from "astro:assets";

import MainLayout from "@layouts/MainLayout.astro";
import Navbar from "@sections/Chrome/Navbar.astro";
import Footer from "@sections/Chrome/Footer.astro";
import ArtworkCard from "@sections/Catalogue/ArtworkCard.astro";
import { useUI, type Locale } from "@/i18n";
import { text } from "@/i18n/localized";
import type { Artwork } from "@utils/artwork-presentation";
import {
  getArtworkPresentation,
  getRelatedArtworks,
  getSite,
} from "@utils/content";
import { picture } from "@utils/images";
import { routes } from "@/routes";
import { artworkSchema, pageContext } from "@utils/seo";

interface Props {
  locale: Locale;
  artwork: Artwork;
}

const { locale, artwork } = Astro.props;
const t = useUI(locale);
const site = await getSite();
const presentation = await getArtworkPresentation(artwork, locale);
const { artist, theme, badge, canInquire, title, image } = presentation;
const isPrivate = presentation.section === "private-collection";

/** Wide WebP for the hover zoom, so the page never ships the original file. */
const zoom = image
  ? await getImage({ src: image.src, format: "webp", width: 2400, quality: 85 })
  : null;
const portrait = picture(artist.data, locale, artist.data.name);
const medium = text(artwork.data.medium, locale);
const description = text(artwork.data.description, locale);
const { width, height, unit } = artwork.data.dimensions;
const related = await getRelatedArtworks(presentation);
const inquiryHref = site.data.email
  ? `mailto:${site.data.email}?subject=${encodeURIComponent(`${title} — ${artist.data.name}`)}`
  : undefined;

const metaDescription = `${title}, ${artist.data.name}${artwork.data.year ? `, ${artwork.data.year}` : ""}. ${medium}, ${width} × ${height} ${unit}.`;
const schema = artworkSchema(pageContext(Astro, locale), presentation, {
  description: description || metaDescription,
  imageSrc: zoom?.src,
});
---

<MainLayout
  locale={locale}
  title={title}
  description={metaDescription}
  schema={schema}
  theme={theme}
>
  <Navbar locale={locale} />

  <article class="artwork">
    <div class="artwork-info">
      <h1 class="artwork-heading">
        <span class="artwork-artist">{artist.data.name}</span>
        <span class="artwork-title">
          <em>
            {title}
            {artwork.data.year && ` (${artwork.data.year})`}
          </em>
        </span>
        <span class="artwork-dimensions">
          <span class="artwork-caps">{t.artworks.framed}</span> {height}
          <span class="artwork-caps">{t.artworks.height}</span> × {width}
          <span class="artwork-caps">{t.artworks.width}</span> {unit}
        </span>
        <span class="artwork-medium">{medium}</span>
      </h1>

      {description && <p class="artwork-description">{description}</p>}

      {canInquire && inquiryHref && (
        <a href={inquiryHref} class="button-outline artwork-action">
          <span>{t.artworks.inquire}</span>
        </a>
      )}
      {badge && <div class="artwork-status">{t.artworks[badge]}</div>}

      <dl class="artwork-notes">
        <div>
          <dt>{t.artworks.noteTitle}</dt>
          <dd>{t.artworks.noteText}</dd>
        </div>
        {!isPrivate && (
          <div>
            <dt>{t.artworks.shippingTitle}</dt>
            <dd>{t.artworks.shippingText}</dd>
          </div>
        )}
      </dl>
    </div>

    <div class="artwork-media">
      {image && (
        <div class="artwork-zoom" data-zoom-src={zoom!.src}>
          <Image
            src={image.src}
            alt={image.alt}
            format="webp"
            width={1600}
            quality={85}
            loading="eager"
          />
        </div>
      )}
    </div>
  </article>

  <section class="related">
    <div class="related-header">
      <h2 class="section-heading">{t.artworks.related}</h2>
      <a
        href={routes.artist(locale, artist)}
        class="related-artist link-underline"
      >
        <span>{t.artworks.viewArtist}</span>
      </a>
    </div>
    <hr class="section-rule" />
    <div class="related-body">
      <ul class="related-grid">
        {related.map((item) => (
          <ArtworkCard presentation={item} />
        ))}
      </ul>
      <aside class="related-artist-card">
        <div class="related-artist-card-inner">
          {portrait && (
            <Image
              src={portrait.src}
              alt={portrait.alt}
              format="webp"
              width={600}
              class="related-portrait"
            />
          )}
          <p class="related-bio">{text(artist.data.shortBio, locale)}</p>
        </div>
      </aside>
    </div>
  </section>

  <Footer locale={locale} />
</MainLayout>

<style>
  .artwork {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(50 * var(--unit-fx));
    margin-block: calc(80 * var(--unit-fx));
    padding-inline: var(--gutter);
  }

  .artwork-info {
    display: flex;
    position: sticky;
    top: calc(80 * var(--unit-fx));
    flex-direction: column;
    justify-content: space-around;
    padding-block: calc(40 * var(--unit-fx));
    max-height: calc(100vh - calc(70 * var(--unit-fx)));
  }

  .artwork-heading {
    margin-top: 0.5rem;
    font-weight: 300;
    font-size: calc(40 * var(--unit-type));
  }

  .artwork-heading > span {
    display: block;
  }

  .artwork-title {
    margin-top: calc(5 * var(--unit-fx));
    color: var(--color-brand);
    font-family: var(--font-baskervville);
  }

  .artwork-dimensions,
  .artwork-medium {
    font-size: calc(35 * var(--unit-type));
  }

  .artwork-caps {
    font-variant: small-caps;
  }

  .artwork-description {
    margin-top: calc(15 * var(--unit-fx));
    max-width: 50ch;
    font-size: calc(14 * var(--unit-type));
  }

  .artwork-action,
  .artwork-status {
    margin: calc(20 * var(--unit-fx)) 0;
    width: 30%;
    font-size: calc(16 * var(--unit-type));
  }

  .artwork-status {
    border: calc(1 * var(--unit-fx)) solid var(--color-button);
    border-radius: var(--radius);
    background-color: var(--color-button);
    padding: calc(10 * var(--unit-fx)) calc(20 * var(--unit-fx));
    color: var(--color-text-secondary);
    font-weight: 600;
    letter-spacing: calc(1 * var(--unit-fx));
    text-align: center;
    text-transform: uppercase;
  }

  .artwork-notes {
    display: flex;
    gap: calc(15 * var(--unit-fx));
    margin-top: auto;
    max-width: 35vw;
  }

  .artwork-notes > div {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: calc(11 * var(--unit-fx));
  }

  .artwork-notes dt {
    font-size: calc(13 * var(--unit-type));
  }

  .artwork-notes dd {
    font-size: calc(10 * var(--unit-type));
  }

  .artwork-media {
    overflow: hidden;
  }

  .artwork-zoom {
    position: relative;
    z-index: 2;
  }

  .artwork-zoom img {
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }

  .artwork-zoom::after {
    position: absolute;
    opacity: 0;
    transition: opacity 0.2s ease;
    inset: 0;
    border-radius: var(--radius);
    background-image: var(--zoom-url);
    background-position: var(--zoom-x) var(--zoom-y);
    background-size: 200%;
    background-color: var(--color-bg-primary);
    pointer-events: none;
    content: "";
  }

  .artwork-zoom.is-zooming::after {
    opacity: 1;
  }

  .related {
    margin-block: calc(80 * var(--unit-fx));
    padding-inline: var(--gutter);
  }

  .related-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .related-artist {
    font-weight: 300;
    font-size: calc(25 * var(--unit-type));
  }

  .related-artist span {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--unit-fx));
  }

  .related-artist :global(svg) {
    width: calc(25 * var(--unit-fx));
    height: calc(25 * var(--unit-fx));
  }

  .related-body {
    display: grid;
    position: relative;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(50 * var(--unit-fx));
    margin-block: calc(50 * var(--unit-fx));
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(50 * var(--unit-fx));
    list-style: none;
  }

  .related-grid :global(.artwork-card) {
    max-width: calc(250 * var(--unit-fx));
  }

  .related-grid :global(.artwork-card-image) {
    height: calc(350 * var(--unit-fx));
  }

  .related-artist-card {
    margin-left: auto;
    width: 17vw;
    pointer-events: none;
  }

  .related-artist-card-inner {
    position: sticky;
    top: calc(30 * var(--unit-fx));
  }

  .related-portrait {
    border-radius: var(--radius);
    width: 100%;
    height: 20vw;
    object-fit: cover;
  }

  .related-bio {
    padding-top: calc(10 * var(--unit-fx));
    font-size: calc(14 * var(--unit-type));
  }

  /* Tablets: image first, then the details at readable sizes. */
  @media screen and (max-width: 1024px) {
    .artwork {
      display: flex;
      flex-direction: column-reverse;
      gap: calc(40 * var(--unit-fx));
    }

    .artwork-info {
      position: static;
      gap: calc(30 * var(--unit-fx));
      padding-block: 0;
      max-height: none;
    }

    .artwork-heading {
      font-size: calc(32 * var(--unit-type));
    }

    .artwork-dimensions,
    .artwork-medium {
      font-size: calc(24 * var(--unit-type));
    }

    .artwork-description {
      font-size: calc(16 * var(--unit-type));
    }

    .artwork-action,
    .artwork-status {
      align-self: flex-start;
      width: auto;
      min-width: 30%;
    }

    .artwork-notes {
      max-width: 100%;
    }

    .artwork-notes dt {
      font-size: calc(14 * var(--unit-type));
    }

    .artwork-notes dd {
      font-size: calc(13 * var(--unit-type));
    }

    .related-artist-card {
      width: 25vw;
    }

    .related-portrait {
      height: 30vw;
    }

    .related-bio {
      font-size: calc(15 * var(--unit-type));
    }
  }

  @media screen and (max-width: 600px) {
    .artwork {
      gap: calc(25 * var(--unit-fx));
    }

    .artwork-info {
      gap: calc(25 * var(--unit-fx));
    }

    .artwork-heading {
      font-size: calc(20 * var(--unit-type));
    }

    .artwork-dimensions,
    .artwork-medium {
      font-size: calc(15 * var(--unit-type));
    }

    .artwork-action,
    .artwork-status {
      order: 2;
      width: 100%;
    }

    .artwork-notes {
      flex-direction: column;
      max-width: 100%;
    }

    .artwork-notes dd,
    .artwork-description {
      font-size: calc(13 * var(--unit-type));
    }

    .related-artist {
      font-size: calc(18 * var(--unit-type));
    }

    .related-artist :global(svg) {
      width: calc(15 * var(--unit-fx));
      height: calc(15 * var(--unit-fx));
    }

    .related-body {
      display: block;
    }

    .related-grid {
      column-gap: calc(20 * var(--unit-fx));
    }

    .related-grid :global(.artwork-card-image) {
      height: calc(220 * var(--unit-fx));
    }

    .related-artist-card {
      display: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "@scripts/motion";

  // Keep the artist card pinned while the related grid scrolls past it.
  const body = document.querySelector<HTMLElement>(".related-body");
  const card = document.querySelector<HTMLElement>(".related-artist-card");
  if (body && card) {
    ScrollTrigger.create({
      trigger: body,
      start: "top top",
      end: () => `+=${body.offsetHeight - card.offsetHeight}`,
      pin: true,
      scrub: 0.5,
    });
  }

  // Hover zoom: the enlarged image follows the pointer. The large image is
  // only requested once the pointer enters, not on page load.
  const zoom = document.querySelector<HTMLElement>(".artwork-zoom");
  if (zoom) {
    zoom.addEventListener(
      "mouseenter",
      () =>
        zoom.style.setProperty("--zoom-url", `url("${zoom.dataset.zoomSrc}")`),
      { once: true },
    );
    zoom.addEventListener("mousemove", (event) => {
      zoom.classList.add("is-zooming");
      zoom.style.setProperty(
        "--zoom-x",
        `${(event.offsetX * 100) / zoom.offsetWidth}%`,
      );
      zoom.style.setProperty(
        "--zoom-y",
        `${(event.offsetY * 100) / zoom.offsetHeight}%`,
      );
    });
    zoom.addEventListener("mouseleave", () =>
      zoom.classList.remove("is-zooming"),
    );
  }
</script>
