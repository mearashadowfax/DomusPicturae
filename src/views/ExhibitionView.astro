---
/** Exhibition detail: practical details, hero image and localised body. */
import { Image } from "astro:assets";
import MainLayout from "@layouts/MainLayout.astro";
import Navbar from "@sections/Chrome/Navbar.astro";
import Footer from "@sections/Chrome/Footer.astro";
import { useUI, type Locale } from "@/i18n";
import { renderBody } from "@utils/content";
import { presentExhibition, type Exhibition } from "@utils/programme";
import { exhibitionMeta, pageContext } from "@utils/seo";

interface Props {
  locale: Locale;
  exhibition: Exhibition;
}

const { locale } = Astro.props;
const t = useUI(locale);
const exhibition = presentExhibition(Astro.props.exhibition, locale);
const { title, image } = exhibition;
const { main: body } = await renderBody("exhibitions", exhibition.id, locale);
const meta = exhibitionMeta(pageContext(Astro, locale), exhibition);
---

<MainLayout locale={locale} {...meta}>
  <Navbar locale={locale} />

  <article class="exhibition">
    <header class="exhibition-header">
      <h1>{title}</h1>
    </header>

    <dl class="exhibition-details">
      <div>
        <dt>{t.events.when}</dt>
        <dd>{exhibition.timeline}</dd>
      </div>
      <div>
        <dt>{t.events.location}</dt>
        <dd>{exhibition.location}</dd>
      </div>
      <div>
        <dt>{t.events.admission}</dt>
        <dd>{exhibition.admission}</dd>
      </div>
      <div>
        <dt>{t.events.openingHours}</dt>
        <dd class="exhibition-hours">
          {exhibition.openingHours.map((item) => (
            <span>
              {item.day} <span>{item.hours}</span>
            </span>
          ))}
        </dd>
      </div>
    </dl>

    <div class="exhibition-body">
      {image && (
        <Image
          src={image.src}
          alt={image.alt}
          class="exhibition-image"
          format="webp"
          width={1600}
          loading="eager"
        />
      )}
      <div class="prose">
        <Fragment set:html={body} />
      </div>
    </div>
  </article>

  <Footer locale={locale} />
</MainLayout>

<style>
  .exhibition-header {
    display: flex;
    align-items: center;
    padding-top: calc(120 * var(--unit-fx));
    padding-bottom: calc(40 * var(--unit-fx));
  }

  .exhibition-header h1 {
    margin: auto;
    font-weight: 300;
    font-size: calc(45 * var(--unit-type));
    line-height: 1.2;
    text-align: center;
  }

  .exhibition-details {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: calc(10 * var(--unit-fx));
    padding-inline: var(--gutter);
  }

  .exhibition-details dt {
    opacity: 0.8;
    margin-bottom: calc(10 * var(--unit-fx));
    font-weight: 600;
    font-size: calc(14 * var(--unit-type));
  }

  .exhibition-details dd {
    font-size: calc(16 * var(--unit-type));
  }

  .exhibition-hours {
    display: flex;
    flex-direction: column;
  }

  .exhibition-hours > span {
    display: flex;
    justify-content: space-between;
    padding: calc(5 * var(--unit-fx)) 0;
  }

  .exhibition-hours > span > span {
    margin-left: auto;
  }

  .exhibition-body {
    margin-top: calc(50 * var(--unit-fx));
    margin-bottom: calc(120 * var(--unit-fx));
    margin-inline: auto;
    padding-inline: var(--gutter);
    width: 65ch;
    max-width: 100%;
    font-size: calc(16 * var(--unit-type));
    line-height: 1.4;
  }

  .exhibition-image {
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .prose :global(p) {
    margin-block: calc(25 * var(--unit-fx));
  }

  @media screen and (max-width: 600px) {
    .exhibition-header h1 {
      padding-inline: var(--gutter);
      font-size: calc(35 * var(--unit-type));
    }

    .exhibition-details {
      grid-template-columns: repeat(2, 1fr);
      row-gap: calc(20 * var(--unit-fx));
    }

    .exhibition-hours > span > span {
      font-weight: 600;
      font-size: calc(13 * var(--unit-type));
    }

    .exhibition-body {
      width: 100%;
    }
  }
</style>
