# Copy to .env (never committed). Every variable is optional.

# Form delivery: a Formspree form (https://formspree.io/f/<id>) or any endpoint
# that accepts a JSON POST. When unset, the forms run in demo mode: the
# submission is validated, logged to the browser console and shown as a
# success, so a fresh clone works before any service is wired up.
# PUBLIC_FORM_NEWSLETTER=https://formspree.io/f/your-id
# PUBLIC_FORM_WORKSHOP=https://formspree.io/f/your-id

# Leave the Keystatic admin out of `astro dev` as well (it is never built).
# SKIP_KEYSTATIC=1
